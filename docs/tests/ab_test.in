filenumber 990000

! A/B regression case for the limitsigma normal-stress ratchet.
!
! Cut down from res632510.in so it finishes in minutes rather than hours:
! 151x151 instead of 601x601, ~2 days instead of 31, and uniform permeability
! instead of the per-cell perm_632510_ds5.txt map. Everything that matters for
! the bug is kept -- problem 3dp (so sigmaconst is .true. and the total normal
! stress MUST stay at sigmainit), pressurediffusion, permev, limitsigma with
! minsig 1 against sigmainit 30, and the real Habanero injection schedule, which
! drives pore pressure well past 29 MPa at the well and then lets it recede.

problem 3dp
imax 151
jmax 151
ds 0.005

interval 20
nstep 40000
tmax 0.00548
dtmax 43200
dtout 1e-4

backslip T
vpl 0d0
a 0.015
b 0.012
dc 1e-4
f0 0.6
muinit 0.37
sigmainit 30.0
velinit 1d-12
limitsigma T
minsig 1
velmin 1d-20

pressurediffusion T
permev T

kpmax 5e-14
kpmin 1e-15
kp 1e-15
phi 0.01
beta 2.005e-8
eta 0.89e-3

kL 1e-3
kT 1e15

pfinit 0d0
bcl Dirichlet
bcr Dirichlet
bct Dirichlet
bcb Dirichlet
pbcl 0d0
pbcr 0d0
pbct 0d0
pbcb 0d0

injectionfromfile T
injection_file "inj_ab_test.txt"

rigid 24
Sw_fwid 7.4e-9
rw 8.9e-2
